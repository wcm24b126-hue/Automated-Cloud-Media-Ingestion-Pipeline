BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
DATABASE_URL=postgres://pipeline_user:pipeline_secure_pass@localhost:5432/mediadb

# Required for production verification and password-reset email delivery.
SMTP_URL=
SMTP_FROM=

# For Cloudflare R2 production deployments only. Keep these server-side.
UPLOAD_MODE=proxy
R2_ENDPOINT=
R2_BUCKET=media-objects
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_PUBLIC_ORIGIN=

# Worker settings: set CLAMAV_ADDRESS=localhost:3310 when using the optional local ClamAV container.
APP_ENV=development
CLAMAV_ADDRESS=
ALLOW_UNSCANNED_LOCAL=false
PROCESSED_BUCKET=processed-media