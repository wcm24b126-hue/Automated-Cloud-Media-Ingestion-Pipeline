{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "signal-media",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "signal-media" }
  ],
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "signal-media-cache" },
    { "binding": "MEDIA_BUCKET", "bucket_name": "signal-media" }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_HYPERDRIVE_ID",
      "localConnectionString": "postgres://pipeline_user:pipeline_secure_pass@localhost:5432/mediadb"
    }
  ]
}